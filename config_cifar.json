{
    "data_root": "data",
    "runner_settings": {
        "output_dir": "experiments_cifar_baselines",
        "use_cache": true,
        "force_recompute": false,
        "visualization_n_bins": 25
    },
    "visualizations": {
        "confidence_curve": {"n_bins": 25},
        "cumulative_mass_curve": {"n_bins": 25},
        "conformal_set_size_distribution": {},
        "one_minus_alpha_coverage_curve": {"alpha": 0.01, "replace_naming_with_ours": true}
    },
    "calibrators": [
        "platt_regression",
        {"name": "naive_cmce", "params": {"tau_min": 1e-3, "tau_max": 1e2, "num_taus": 1000, "n_bins": 25, "strategy": "uniform", "weighted": true}},
        {
            "name": "dirichlet",
            "params": {
                "matrix_type": "full",
                "l2": 0.01,
                "comp_l2": false,
                "initializer": "identity"
            }
        },
        "adaptive_temperature_scaling"
    ],
    "metrics": [
        "accuracy",
        {"name": "ece", "params": {"n_bins": 25}},
        {"name": "mce", "params": {"n_bins": 25}},
        {"name": "cw-ece", "params": {"n_bins": 25}},
        "nll",
        "brier_score",
        {
            "name": "cmce",
            "params": {"n_bins": 25, "strategy": "uniform", "weighted": true}
        },
        {
            "name": "coverage_around_one_minus_alpha",
            "params": {"alpha": 0.3, "eps": 0.02}
        },
        {
            "name": "coverage_around_one_minus_alpha",
            "params": {"alpha": 0.1, "eps": 0.02}
        },
        {
            "name": "coverage_around_one_minus_alpha",
            "params": {"alpha": 0.01, "eps": 0.005}
        }
    ],
    "evaluations": [
        {
            "dataset": {"name": "cifar10"},
            "model": {
                "source": "torch_hub",
                "repo": "chenyaofo/pytorch-cifar-models",
                "name": "cifar10_resnet20",
                "alias": "ResNet20"
            }
        },
        {
            "dataset": {"name": "cifar10"},
            "model": {
                "source": "torch_hub",
                "repo": "chenyaofo/pytorch-cifar-models",
                "name": "cifar10_resnet56",
                "alias": "ResNet56"
            }
        },
        {
            "dataset": {"name": "cifar100"},
            "model": {
                "source": "torch_hub",
                "repo": "chenyaofo/pytorch-cifar-models",
                "name": "cifar100_resnet56",
                "alias": "ResNet56"
            }
        },
        {
            "dataset": {"name": "cifar100", "params": {"image_size": 224}},
            "model": {
                "source": "vit",
                "name": "pkr7098/cifar100-vit-base-patch16-224-in21k",
                "alias": "ViT-B16"
            }
        }
    ]
}
