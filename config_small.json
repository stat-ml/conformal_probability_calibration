{
    "data_root": "data",
    "runner_settings": {
        "output_dir": "experiments_small",
        "use_cache": true,
        "force_recompute": false,
        "visualization_n_bins": 20
    },
    "visualizations": {
        "confidence_curve": {"n_bins": 20},
        "cumulative_mass_curve": {"n_bins": 20},
        "one_minus_alpha_coverage_curve": {"alpha": 0.1}
    },
    "calibrators": [
        "temperature_scaling",
        {"name": "venn_abers", "params": {"va_type": "one_vs_one"}},
        {"name": "venn_abers", "params": {"va_type": "one_vs_all"}},
        {
            "name": "conformal_mass_threshold",
            "params": {
                "score_type": "thr",
                "alpha": 0.1,
                "score_transformation": "identity"
            }
        }
    ],
    "metrics": [
        "accuracy",
        "roc_auc",
        {"name": "ece", "params": {"n_bins": 20}},
        {"name": "mce", "params": {"n_bins": 20}},
        {"name": "cw-ece", "params": {"n_bins": 20}},
        "nll",
        "brier_score",
        {
            "name": "coverage_around_one_minus_alpha",
            "params": {"alpha": 0.1, "eps": 0.02}
        },
        {
            "name": "coverage_around_one_minus_alpha",
            "params": {"alpha": 0.3, "eps": 0.02}
        },
        {
            "name": "cmce",
            "params": {"n_bins": 25, "strategy": "uniform", "weighted": true}
        }
    ],
    "evaluations": [
        {
            "dataset": {"name": "cifar10"},
            "model": {
                "source": "torch_hub",
                "repo": "chenyaofo/pytorch-cifar-models",
                "name": "cifar10_resnet56",
                "alias": "ResNet56"
            }
        },
        {
            "dataset": {"name": "imagenet-mini"},
            "model": {
                "source": "vit",
                "name": "google/vit-base-patch16-224",
                "alias": "ViT-B16"
            }
        },
        {
            "dataset": {"name": "inaturalist"},
            "model": {
                "source": "vit",
                "name": "bryanzhou008/vit-base-patch16-224-in21k-finetuned-inaturalist",
                "alias": "ViT-B16"
            }
        },
        {
            "dataset": {"name": "imagenet-mini"},
            "model": {
                "source": "vit",
                "name": "google/vit-base-patch16-224",
                "alias": "ViT-B16"
            }
        },
        {
            "dataset": {"name": "inaturalist", "params": {"image_size": 224}},
            "model": {
                "source": "birder",
                "name": "rope_vit_reg4_b14_capi-inat21-224px",
                "alias": "Birder-ViT-B14"
            }
        }
    ]
}
