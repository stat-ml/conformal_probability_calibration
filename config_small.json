{
    "data_root": "data",
    "runner_settings": {
        "output_dir": "experiments_small",
        "use_cache": true,
        "force_recompute": false,
        "visualization_n_bins": 20
    },
    "visualizations": {
        "confidence_curve": {
            "n_bins": 20
        },
        "cumulative_mass_curve": {
            "n_bins": 20
        }
    },
    "calibrators": [
        "temperature_scaling",
        "isotonic_regression",
        {"name": "conformal_mass_threshold", "params": { "score_type": "aps", "alpha": 0.1 }},
        {"name": "conformal_temperature", "params": { "score_type": "aps", "alpha": 0.1 }},
        {"name": "venn_abers", "params": {"va_type": "one_vs_one"}},
        {"name": "venn_abers", "params": {"va_type": "one_vs_all"}}
    ],
    "metrics": [
        "accuracy",
        "roc_auc",
        { "name": "ece", "params": { "n_bins": 20 } },
        { "name": "mce", "params": { "n_bins": 20 } },
        { "name": "cw-ece", "params": { "n_bins": 20 } },
        "nll",
        "brier_score"
    ],
    "evaluations": [
        {
            "dataset": { "name": "cifar10" },
            "model": {
                "source": "torch_hub",
                "repo": "chenyaofo/pytorch-cifar-models",
                "name": "cifar10_resnet56",
                "alias": "ResNet56"
            }
        },
        {
            "dataset": {
                "name": "cifar100",
                "params": { "image_size": 224 }
            },
            "model": {
                "source": "vit",
                "name": "pkr7098/cifar100-vit-base-patch16-224-in21k",
                "alias": "ViT-B16"
            }
        }
    ]
}
