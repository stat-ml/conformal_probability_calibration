{
    "data_root": "data",
    "runner_settings": {
        "output_dir": "experiments_synthetic",
        "use_cache": true,
        "force_recompute": false,
        "visualization_n_bins": 25
    },
    "visualizations": {
        "confidence_curve": {
            "n_bins": 25
        },
        "cumulative_mass_curve": {
            "n_bins": 25
        },
        "conformal_set_size_distribution": {},
        "one_minus_alpha_coverage_curve": {
            "alpha": 0.1
        }
    },
    "calibrators": [
        "temperature_scaling",
        "isotonic_regression",
        {
            "name": "conformal_mass_threshold",
            "params": {
                "score_type": "one_minus_prob",
                "alpha": 0.1,
                "score_transformation": "identity"
            }
        }
    ],
    "metrics": [
        "accuracy",
        {
            "name": "ece",
            "params": {
                "n_bins": 25
            }
        },
        {
            "name": "mce",
            "params": {
                "n_bins": 25
            }
        },
        {
            "name": "cw-ece",
            "params": {
                "n_bins": 25
            }
        },
        "nll",
        "brier_score",
        {
            "name": "cmce",
            "params": {
                "n_bins": 25,
                "strategy": "uniform",
                "weighted": true
            }
        }
    ],
    "evaluations": [
        {
            "dataset": {
                "name": "synthetic",
                "params": {
                    "n_classes": 50
                }
            },
            "model": {
                "source": "ours",
                "name": "mlp",
                "alias": "SimpleMLP",
                "params": {
                    "n_classes": 50
                }
            }
        }
    ]
}
