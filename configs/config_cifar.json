{
    "data_root": "data",
    "runner_settings": {
        "output_dir": "experiments_cifar",
        "use_cache": true,
        "force_recompute": false,
        "visualization_n_bins": 25
    },
    "visualizations": {
        "confidence_curve": {"n_bins": 25},
        "cumulative_mass_curve": {"n_bins": 25},
        "conformal_set_size_distribution": {},
        "one_minus_alpha_coverage_curve": {"alpha": 0.1}
    },
    "calibrators": [
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.01, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.05, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.1, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.15, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.2, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.25, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.3, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.35, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.4, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.45, "score_transformation": "identity"}},
        {"name": "conformal_mass_threshold", "params": {"score_type": "msp", "alpha": 0.5, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.01, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.05, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.1, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.15, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.2, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.25, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.3, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.35, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.4, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.45, "score_transformation": "identity"}},
        {"name": "conformal_temperature", "params": {"score_type": "msp", "alpha": 0.5, "score_transformation": "identity"}}
    ],
    "metrics": [
        "accuracy",
        {"name": "ece", "params": {"n_bins": 25}},
        {"name": "mce", "params": {"n_bins": 25}},
        {"name": "cw-ece", "params": {"n_bins": 25}},
        "nll",
        "brier_score",
        {
            "name": "cmce",
            "params": {"n_bins": 25, "strategy": "uniform", "weighted": true}
        },
        {
            "name": "coverage_around_one_minus_alpha",
            "params": {"alpha": 0.3, "eps": 0.02}
        },
        {
            "name": "coverage_around_one_minus_alpha",
            "params": {"alpha": 0.1, "eps": 0.02}
        },
        {
            "name": "coverage_around_one_minus_alpha",
            "params": {"alpha": 0.01, "eps": 0.005}
        }
    ],
    "evaluations": [
        {
            "dataset": {"name": "cifar100", "params": {"image_size": 224}},
            "model": {
                "source": "vit",
                "name": "pkr7098/cifar100-vit-base-patch16-224-in21k",
                "alias": "ViT-B16"
            }
        }
    ]
}
