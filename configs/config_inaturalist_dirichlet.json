{
    "data_root": "data",
    "runner_settings": {
        "output_dir": "experiments_inaturalist_dirichlet",
        "use_cache": true,
        "force_recompute": false
    },
    "calibrators": [
        {"name": "dirichlet", "params": {"matrix_type": "diagonal", "l2": 0.0, "initializer": "identity", "maxiter": 100}}
    ],
    "metrics": [
        {"name": "ece", "params": {"n_bins": 25}},
        {"name": "mce", "params": {"n_bins": 25}},
        {"name": "cw-ece", "params": {"n_bins": 25}},
        "nll",
        "brier_score",
        {"name": "cmce", "params": {"n_bins": 25, "strategy": "uniform", "weighted": true}},
        {"name": "alpha_suffix_coverage", "params": {"alpha": 0.1}},
        {"name": "alpha_suffix_coverage_difference", "params": {"alpha": 0.1}}
    ],
    "evaluations": [
        {
            "dataset": {"name": "inaturalist", "params": {"image_size": 224}},
            "model": {
                "source": "birder",
                "name": "rope_vit_reg4_b14_capi-inat21-224px",
                "alias": "Birder-ViT-B14"
            }
        }
    ]
}
